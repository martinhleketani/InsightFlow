<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="InsightFlow.ReportsPage"
    Title="Reports"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">

        <!-- =====================================================
             HEADER
             ===================================================== -->
        <Border
            Grid.Row="0"
            BackgroundColor="#0F2747"
            StrokeThickness="0"
            Padding="25,18">

            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="15">

                <Button
                    Grid.Column="0"
                    Text="← Back"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="OnBackClicked" />

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="3">

                    <Label
                        Text="REPORTS"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Company, department and employee reporting"
                        FontSize="11"
                        TextColor="#93C5FD" />

                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="REFRESH"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="OnRefreshClicked" />

            </Grid>

        </Border>


        <!-- =====================================================
             CONTENT
             ===================================================== -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="25"
                Spacing="20">


                <!-- =================================================
                     TITLE
                     ================================================= -->
                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="3">

                        <Label
                            Text="Management Reports"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Label
                            x:Name="LastUpdatedLabel"
                            Text="Waiting for report data"
                            FontSize="11"
                            TextColor="#64748B" />

                    </VerticalStackLayout>

                    <ActivityIndicator
                        Grid.Column="1"
                        x:Name="LoadingIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        Color="#2563EB"
                        WidthRequest="35"
                        HeightRequest="35" />

                </Grid>


                <!-- =================================================
                     ERROR
                     ================================================= -->
                <Border
                    x:Name="ErrorBorder"
                    IsVisible="False"
                    BackgroundColor="#FEF2F2"
                    Stroke="#FECACA"
                    StrokeShape="RoundRectangle 8"
                    Padding="12">

                    <Label
                        x:Name="ErrorLabel"
                        FontSize="11"
                        TextColor="#DC2626" />

                </Border>


                <!-- =================================================
                     REPORT FILTERS
                     ================================================= -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <Label
                            Text="Report Filters"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />


                        <!-- =========================================
                             FILTER ROW 1
                             ========================================= -->
                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="15">


                            <!-- REPORT SCOPE -->
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="5">

                                <Label
                                    Text="Report Scope"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                                <Border
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#CBD5E1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,0">

                                    <Picker
                                        x:Name="ReportScopePicker"
                                        SelectedIndexChanged="OnReportScopeChanged">

                                        <Picker.Items>

                                            <x:String>Company</x:String>

                                            <x:String>Department</x:String>

                                            <x:String>Employee</x:String>

                                        </Picker.Items>

                                    </Picker>

                                </Border>

                            </VerticalStackLayout>


                            <!-- DEPARTMENT -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5">

                                <Label
                                    Text="Department"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                                <Border
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#CBD5E1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,0">

                                    <Picker
                                        x:Name="DepartmentPicker"
                                        SelectedIndexChanged="OnDepartmentChanged">

                                        <Picker.Items>

                                            <x:String>All Departments</x:String>

                                            <x:String>Sales</x:String>

                                            <x:String>Finance</x:String>

                                            <x:String>Human Resources</x:String>

                                            <x:String>Information Technology</x:String>

                                            <x:String>Marketing</x:String>

                                            <x:String>Operations</x:String>

                                            <x:String>Customer Service</x:String>

                                            <x:String>Procurement</x:String>

                                            <x:String>Management</x:String>

                                        </Picker.Items>

                                    </Picker>

                                </Border>

                            </VerticalStackLayout>


                            <!-- STATUS -->
                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="5">

                                <Label
                                    Text="Status"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                                <Border
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#CBD5E1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,0">

                                    <Picker
                                        x:Name="StatusPicker">

                                        <Picker.Items>

                                            <x:String>All Statuses</x:String>

                                            <x:String>Completed</x:String>

                                            <x:String>In Progress</x:String>

                                            <x:String>Pending</x:String>

                                            <x:String>On Hold</x:String>

                                        </Picker.Items>

                                    </Picker>

                                </Border>

                            </VerticalStackLayout>

                        </Grid>


                        <!-- =========================================
                             FILTER ROW 2
                             ========================================= -->
                        <Grid
                            ColumnDefinitions="2*,*,*"
                            ColumnSpacing="15">


                            <!-- EMPLOYEE -->
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="5">

                                <Label
                                    Text="Employee"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                                <Border
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#CBD5E1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,0">

                                    <Picker
                                        x:Name="EmployeePicker" />

                                </Border>

                            </VerticalStackLayout>


                            <!-- START DATE -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5">

                                <Label
                                    Text="Start Date"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                                <Border
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#CBD5E1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,0">

                                    <DatePicker
                                        x:Name="StartDatePicker"
                                        Format="dd MMM yyyy"
                                        TextColor="#0F172A" />

                                </Border>

                            </VerticalStackLayout>


                            <!-- END DATE -->
                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="5">

                                <Label
                                    Text="End Date"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                                <Border
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#CBD5E1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,0">

                                    <DatePicker
                                        x:Name="EndDatePicker"
                                        Format="dd MMM yyyy"
                                        TextColor="#0F172A" />

                                </Border>

                            </VerticalStackLayout>

                        </Grid>


                        <!-- =========================================
                             BUTTONS
                             ========================================= -->
                        <Grid
                            ColumnDefinitions="Auto,Auto,Auto,*"
                            ColumnSpacing="10">


                            <!-- GENERATE SCREEN REPORT -->
                            <Button
                                x:Name="GenerateReportButton"
                                Grid.Column="0"
                                Text="GENERATE REPORT"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Padding="18,10"
                                Clicked="OnGenerateReportClicked" />


                            <!-- GENERATE PDF -->
                            <Button
                                x:Name="GeneratePdfButton"
                                Grid.Column="1"
                                Text="GENERATE PDF"
                                BackgroundColor="#0F2747"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Padding="18,10"
                                Clicked="OnGeneratePdfClicked" />


                            <!-- RESET -->
                            <Button
                                x:Name="ResetReportButton"
                                Grid.Column="2"
                                Text="RESET"
                                BackgroundColor="#E2E8F0"
                                TextColor="#0F172A"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Padding="18,10"
                                Clicked="OnResetFiltersClicked" />


                            <!-- FILTER SUMMARY -->
                            <Label
                                Grid.Column="3"
                                x:Name="ReportFilterSummaryLabel"
                                Text="Company"
                                FontSize="10"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End"
                                VerticalTextAlignment="Center" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     REPORT TITLE
                     ================================================= -->
                <Border
                    BackgroundColor="#0F2747"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="5">

                            <Label
                                x:Name="ReportTitleLabel"
                                Text="Company Performance Report"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                x:Name="ReportPeriodLabel"
                                Text="No report generated"
                                FontSize="10"
                                TextColor="#BFDBFE" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="INSIGHTFLOW"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#93C5FD"
                            VerticalTextAlignment="Center" />

                    </Grid>

                </Border>


                <!-- =================================================
                     KPI ROW 1
                     ================================================= -->
                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="15">


                    <!-- ACTIVITIES -->
                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="ACTIVITIES"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="TotalActivitiesLabel"
                                Text="0"
                                FontSize="27"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Records in report"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- COMPLETED -->
                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="COMPLETED"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="CompletedLabel"
                                Text="0"
                                FontSize="27"
                                FontAttributes="Bold"
                                TextColor="#16A34A" />

                            <Label
                                Text="Completed activities"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- COMPLETION RATE -->
                    <Border
                        Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="COMPLETION RATE"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="CompletionRateLabel"
                                Text="0%"
                                FontSize="27"
                                FontAttributes="Bold"
                                TextColor="#2563EB" />

                            <Label
                                Text="Completed / total"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- BUSINESS VALUE -->
                    <Border
                        Grid.Column="3"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="BUSINESS VALUE"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="BusinessValueLabel"
                                Text="R 0.00"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Recorded business value"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- =================================================
                     KPI ROW 2
                     ================================================= -->
                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="15">


                    <!-- CONTRIBUTORS -->
                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="CONTRIBUTORS"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="ContributorsLabel"
                                Text="0"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Employees in report"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- TOTAL QUANTITY -->
                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="TOTAL QUANTITY"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="TotalQuantityLabel"
                                Text="0"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Recorded output"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- IN PROGRESS -->
                    <Border
                        Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="IN PROGRESS"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="InProgressLabel"
                                Text="0"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="#F59E0B" />

                            <Label
                                Text="Active activities"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- PENDING / HOLD -->
                    <Border
                        Grid.Column="3"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="PENDING / HOLD"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="PendingHoldLabel"
                                Text="0"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="#DC2626" />

                            <Label
                                Text="Pending or on hold"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- =================================================
                     BREAKDOWN
                     ================================================= -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <Label
                            x:Name="BreakdownTitleLabel"
                            Text="Department Breakdown"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />


                        <!-- BREAKDOWN HEADER -->
                        <Grid
                            ColumnDefinitions="2*,*,*,*,*"
                            ColumnSpacing="10">

                            <Label
                                Grid.Column="0"
                                Text="NAME"
                                FontSize="8"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="ACTIVITIES"
                                FontSize="8"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                            <Label
                                Grid.Column="2"
                                Text="COMPLETED"
                                FontSize="8"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                            <Label
                                Grid.Column="3"
                                Text="RATE"
                                FontSize="8"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                            <Label
                                Grid.Column="4"
                                Text="VALUE"
                                FontSize="8"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                        </Grid>


                        <!-- BREAKDOWN DATA -->
                        <CollectionView
                            x:Name="BreakdownCollectionView"
                            SelectionMode="None"
                            HeightRequest="220">

                            <CollectionView.EmptyView>

                                <Label
                                    Text="No breakdown data available."
                                    FontSize="11"
                                    TextColor="#94A3B8"
                                    HorizontalTextAlignment="Center"
                                    Margin="0,20" />

                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Margin="0,5,0,0"
                                        Padding="10"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 8">

                                        <Grid
                                            ColumnDefinitions="2*,*,*,*,*"
                                            ColumnSpacing="10">

                                            <Label
                                                Grid.Column="0"
                                                Text="{Binding Name}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="#0F172A" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding ActivitiesDisplay}"
                                                FontSize="10"
                                                TextColor="#0F172A"
                                                HorizontalTextAlignment="End" />

                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding CompletedDisplay}"
                                                FontSize="10"
                                                TextColor="#16A34A"
                                                HorizontalTextAlignment="End" />

                                            <Label
                                                Grid.Column="3"
                                                Text="{Binding CompletionRateDisplay}"
                                                FontSize="10"
                                                TextColor="#2563EB"
                                                HorizontalTextAlignment="End" />

                                            <Label
                                                Grid.Column="4"
                                                Text="{Binding BusinessValueDisplay}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="#0F172A"
                                                HorizontalTextAlignment="End" />

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Border>


                <!-- =================================================
                     REPORT RECORDS
                     ================================================= -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <Grid
                        RowDefinitions="Auto,Auto,*"
                        RowSpacing="12">


                        <!-- RECORD TITLE -->
                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="Report Records"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Grid.Column="1"
                                x:Name="RecordCountLabel"
                                Text="0 records"
                                FontSize="10"
                                TextColor="#64748B"
                                VerticalTextAlignment="Center" />

                        </Grid>


                        <!-- TABLE HEADER -->
                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="1.2*,1.1*,1.2*,1.3*,0.9*,0.8*"
                            ColumnSpacing="10"
                            Padding="12,5">

                            <Label
                                Grid.Column="0"
                                Text="EMPLOYEE"
                                FontSize="8"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="DEPARTMENT"
                                FontSize="8"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="2"
                                Text="ACTIVITY"
                                FontSize="8"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="3"
                                Text="REFERENCE"
                                FontSize="8"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="4"
                                Text="VALUE"
                                FontSize="8"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                            <Label
                                Grid.Column="5"
                                Text="STATUS"
                                FontSize="8"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                        </Grid>


                        <!-- REPORT RECORDS COLLECTION -->
                        <CollectionView
                            Grid.Row="2"
                            x:Name="ReportRecordsCollectionView"
                            SelectionMode="None"
                            HeightRequest="450">

                            <CollectionView.EmptyView>

                                <VerticalStackLayout
                                    Padding="30"
                                    Spacing="8">

                                    <Label
                                        Text="No records match this report"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="#64748B"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Text="Change the report filters and generate the report again."
                                        FontSize="10"
                                        TextColor="#94A3B8"
                                        HorizontalTextAlignment="Center" />

                                </VerticalStackLayout>

                            </CollectionView.EmptyView>


                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Margin="0,6,0,0"
                                        Padding="12"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 8">

                                        <Grid
                                            ColumnDefinitions="1.2*,1.1*,1.2*,1.3*,0.9*,0.8*"
                                            RowDefinitions="Auto,Auto"
                                            ColumnSpacing="10"
                                            RowSpacing="6">


                                            <!-- EMPLOYEE -->
                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="2">

                                                <Label
                                                    Text="{Binding EmployeeNameDisplay}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#0F172A" />

                                                <Label
                                                    Text="{Binding EmployeeIdDisplay}"
                                                    FontSize="8"
                                                    TextColor="#94A3B8" />

                                            </VerticalStackLayout>


                                            <!-- DEPARTMENT -->
                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Spacing="2">

                                                <Label
                                                    Text="{Binding DepartmentDisplay}"
                                                    FontSize="9"
                                                    TextColor="#0F172A" />

                                                <Label
                                                    Text="{Binding DateDisplay}"
                                                    FontSize="8"
                                                    TextColor="#94A3B8" />

                                            </VerticalStackLayout>


                                            <!-- ACTIVITY -->
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Text="{Binding ActivityTypeDisplay}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="#0F172A"
                                                VerticalTextAlignment="Center" />


                                            <!-- REFERENCE -->
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Text="{Binding ReferenceDisplay}"
                                                FontSize="9"
                                                TextColor="#64748B"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation"
                                                VerticalTextAlignment="Center" />


                                            <!-- VALUE -->
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="4"
                                                Text="{Binding BusinessValueDisplay}"
                                                FontSize="10"
                                                FontAttributes="Bold"
                                                TextColor="#0F172A"
                                                HorizontalTextAlignment="End"
                                                VerticalTextAlignment="Center" />


                                            <!-- STATUS -->
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="5"
                                                Text="{Binding StatusDisplay}"
                                                FontSize="9"
                                                FontAttributes="Bold"
                                                TextColor="#2563EB"
                                                HorizontalTextAlignment="End"
                                                VerticalTextAlignment="Center" />


                                            <!-- DETAILS -->
                                            <Label
