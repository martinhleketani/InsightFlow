<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="InsightFlow.RegionsPage"
    Title="Departments"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Border
            Grid.Row="0"
            BackgroundColor="#0F2747"
            StrokeThickness="0"
            Padding="25,18">

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="15">

                <Button
                    Grid.Column="0"
                    Text="← Back"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="OnBackClicked" />

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="3">

                    <Label
                        Text="DEPARTMENTS"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Company department activity and performance comparison"
                        FontSize="11"
                        TextColor="#93C5FD" />

                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="REFRESH"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="OnRefreshClicked" />

            </Grid>

        </Border>


        <!-- MAIN CONTENT -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="25"
                Spacing="20">

                <!-- PAGE TITLE -->
                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="3">

                        <Label
                            Text="Department Overview"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Label
                            x:Name="LastUpdatedLabel"
                            Text="Waiting for department data"
                            FontSize="11"
                            TextColor="#64748B" />

                    </VerticalStackLayout>

                    <ActivityIndicator
                        Grid.Column="1"
                        x:Name="LoadingIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        Color="#2563EB"
                        WidthRequest="35"
                        HeightRequest="35" />

                </Grid>


                <!-- ERROR -->
                <Border
                    x:Name="ErrorBorder"
                    IsVisible="False"
                    BackgroundColor="#FEF2F2"
                    Stroke="#FECACA"
                    StrokeShape="RoundRectangle 8"
                    Padding="12">

                    <Label
                        x:Name="ErrorLabel"
                        FontSize="11"
                        TextColor="#DC2626" />

                </Border>


                <!-- COMPANY KPI CARDS -->
                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="15">

                    <!-- DEPARTMENTS -->
                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="DEPARTMENTS"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="DepartmentsLabel"
                                Text="9"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Configured departments"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- TOTAL ACTIVITIES -->
                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="TOTAL ACTIVITIES"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="TotalActivitiesLabel"
                                Text="0"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#2563EB" />

                            <Label
                                Text="Company submissions"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- ACTIVE DEPARTMENTS -->
                    <Border
                        Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="ACTIVE DEPARTMENTS"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="ActiveDepartmentsLabel"
                                Text="0"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#16A34A" />

                            <Label
                                Text="With submitted records"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- BUSINESS VALUE -->
                    <Border
                        Grid.Column="3"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="BUSINESS VALUE"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="BusinessValueLabel"
                                Text="R 0.00"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Across all records"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- SECONDARY KPI -->
                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="15">

                    <!-- COMPLETED -->
                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="COMPLETED"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="CompletedLabel"
                                Text="0"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="#16A34A" />

                            <Label
                                Text="Completed company records"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- COMPLETION RATE -->
                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="COMPLETION RATE"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="CompletionRateLabel"
                                Text="0%"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="#2563EB" />

                            <Label
                                Text="Completed / total"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- CONTRIBUTORS -->
                    <Border
                        Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="CONTRIBUTORS"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="ContributorsLabel"
                                Text="0"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Employees with submissions"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- COMPANY WORK STATUS -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <Label
                            Text="Company Work Status"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Grid
                            ColumnDefinitions="*,*,*,*"
                            ColumnSpacing="20">

                            <!-- COMPLETED -->
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="Completed"
                                    FontSize="10"
                                    TextColor="#64748B" />

                                <Label
                                    x:Name="StatusCompletedLabel"
                                    Text="0"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#16A34A" />

                            </VerticalStackLayout>


                            <!-- IN PROGRESS -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4">

                                <Label
                                    Text="In Progress"
                                    FontSize="10"
                                    TextColor="#64748B" />

                                <Label
                                    x:Name="StatusInProgressLabel"
                                    Text="0"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#2563EB" />

                            </VerticalStackLayout>


                            <!-- PENDING -->
                            <VerticalStackLayout
                                Grid.Column="2"
                                Spacing="4">

                                <Label
                                    Text="Pending"
                                    FontSize="10"
                                    TextColor="#64748B" />

                                <Label
                                    x:Name="StatusPendingLabel"
                                    Text="0"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                            </VerticalStackLayout>


                            <!-- ON HOLD -->
                            <VerticalStackLayout
                                Grid.Column="3"
                                Spacing="4">

                                <Label
                                    Text="On Hold"
                                    FontSize="10"
                                    TextColor="#64748B" />

                                <Label
                                    x:Name="StatusOnHoldLabel"
                                    Text="0"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#64748B" />

                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- DEPARTMENT COMPARISON -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <Grid RowDefinitions="Auto,Auto,*">

                        <VerticalStackLayout
                            Grid.Row="0"
                            Spacing="3"
                            Margin="0,0,0,15">

                            <Label
                                Text="Department Comparison"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Activity and recorded output for each company department"
                                FontSize="10"
                                TextColor="#64748B" />

                        </VerticalStackLayout>


                        <!-- TABLE HEADINGS -->
                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="1.6*,0.7*,0.7*,0.9*,1*,0.8*"
                            ColumnSpacing="12"
                            Padding="12"
                            BackgroundColor="#F1F5F9">

                            <Label
                                Grid.Column="0"
                                Text="DEPARTMENT"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                Grid.Column="1"
                                Text="ACTIVITY"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Grid.Column="2"
                                Text="DONE"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Grid.Column="3"
                                Text="RATE"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Grid.Column="4"
                                Text="VALUE"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="End" />

                            <Label
                                Grid.Column="5"
                                Text="STAFF"
                                FontSize="9"
                                FontAttributes="Bold"
                                TextColor="#64748B"
                                HorizontalTextAlignment="Center" />

                        </Grid>


                        <CollectionView
                            Grid.Row="2"
                            x:Name="DepartmentCollectionView"
                            SelectionMode="None"
                            HeightRequest="480">

                            <CollectionView.EmptyView>

                                <Label
                                    Text="No department data available."
                                    TextColor="#94A3B8"
                                    HorizontalTextAlignment="Center"
                                    Margin="30" />

                            </CollectionView.EmptyView>


                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Margin="0,6,0,0"
                                        Padding="12"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 8">

                                        <Grid
                                            ColumnDefinitions="1.6*,0.7*,0.7*,0.9*,1*,0.8*"
                                            ColumnSpacing="12">

                                            <!-- DEPARTMENT -->
                                            <VerticalStackLayout
                                                Grid.Column="0"
                                                Spacing="2">

                                                <Label
                                                    Text="{Binding DepartmentName}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#0F172A" />

                                                <Label
                                                    Text="{Binding DepartmentCode}"
                                                    FontSize="9"
                                                    TextColor="#94A3B8" />

                                            </VerticalStackLayout>


                                            <!-- ACTIVITY - FIXED -->
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding ActivityCount}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="#0F172A"
                                                VerticalTextAlignment="Center"
                                                HorizontalTextAlignment="Center" />


                                            <!-- DONE - FIXED -->
                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding Completed}"
                                                FontSize="11"
                                                TextColor="#16A34A"
                                                FontAttributes="Bold"
                                                VerticalTextAlignment="Center"
                                                HorizontalTextAlignment="Center" />


                                            <!-- RATE -->
                                            <Label
                                                Grid.Column="3"
                                                Text="{Binding CompletionRateDisplay}"
                                                FontSize="11"
                                                TextColor="#2563EB"
                                                FontAttributes="Bold"
                                                VerticalTextAlignment="Center"
                                                HorizontalTextAlignment="Center" />


                                            <!-- VALUE -->
                                            <Label
                                                Grid.Column="4"
                                                Text="{Binding BusinessValueDisplay}"
                                                FontSize="11"
                                                TextColor="#0F172A"
                                                FontAttributes="Bold"
                                                VerticalTextAlignment="Center"
                                                HorizontalTextAlignment="End" />


                                            <!-- STAFF -->
                                            <Label
                                                Grid.Column="5"
                                                Text="{Binding ContributorsDisplay}"
                                                FontSize="11"
                                                TextColor="#0F172A"
                                                VerticalTextAlignment="Center"
                                                HorizontalTextAlignment="Center" />

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </Grid>

                </Border>


                <!-- SEARCH -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="15">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="15">

                        <Border
                            Grid.Column="0"
                            BackgroundColor="#F8FAFC"
                            Stroke="#CBD5E1"
                            StrokeShape="RoundRectangle 8"
                            Padding="10,2">

                            <Entry
                                x:Name="SearchEntry"
                                Placeholder="Search department, employee, activity, reference or status..."
                                TextColor="#0F172A"
                                PlaceholderColor="#94A3B8"
                                TextChanged="OnSearchTextChanged" />

                        </Border>

                        <Label
                            Grid.Column="1"
                            x:Name="RecordCountLabel"
                            Text="0 records"
                            FontSize="11"
                            TextColor="#64748B"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>


                <!-- DEPARTMENT RECORDS -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <Grid RowDefinitions="Auto,*">

                        <VerticalStackLayout
                            Grid.Row="0"
                            Spacing="3"
                            Margin="0,0,0,15">

                            <Label
                                Text="Department Records"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Employee submissions across all departments"
                                FontSize="10"
                                TextColor="#64748B" />

                        </VerticalStackLayout>


                        <CollectionView
                            Grid.Row="1"
                            x:Name="RecordsCollectionView"
                            SelectionMode="None"
                            HeightRequest="420">

                            <CollectionView.EmptyView>

                                <VerticalStackLayout
                                    Padding="30"
                                    Spacing="8">

                                    <Label
                                        Text="No records found"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="#64748B"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Text="Employee submissions will appear here."
                                        FontSize="11"
                                        TextColor="#94A3B8"
                                        HorizontalTextAlignment="Center" />

                                </VerticalStackLayout>

                            </CollectionView.EmptyView>


                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="15"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 10">

                                        <Grid
                                            ColumnDefinitions="1.3*,1.3*,1.5*,1*,Auto"
                                            RowDefinitions="Auto,Auto"
                                            ColumnSpacing="15"
                                            RowSpacing="6">

                                            <!-- DEPARTMENT -->
                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="3">

                                                <Label
                                                    Text="{Binding Department}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="#0F172A" />

                                                <Label
                                                    Text="{Binding DepartmentCode}"
                                                    FontSize="9"
                                                    TextColor="#94A3B8" />

                                            </VerticalStackLayout>


                                            <!-- EMPLOYEE -->
                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Spacing="3">

                                                <Label
                                                    Text="{Binding EmployeeName}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#0F172A" />

                                                <Label
                                                    Text="{Binding EmployeeId}"
                                                    FontSize="9"
                                                    TextColor="#94A3B8" />

                                            </VerticalStackLayout>


                                            <!-- ACTIVITY -->
                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Spacing="3">

                                                <Label
                                                    Text="{Binding ActivityType}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#0F172A" />

                                                <Label
                                                    Text="{Binding ReferenceDisplay}"
                                                    FontSize="9"
                                                    TextColor="#64748B" />

                                            </VerticalStackLayout>


                                            <!-- VALUE -->
                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Spacing="3">

                                                <Label
                                                    Text="{Binding BusinessValueDisplay}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#0F172A" />

                                                <Label
                                                    Text="{Binding QuantityDisplay}"
                                                    FontSize="9"
                                                    TextColor="#64748B" />

                                            </VerticalStackLayout>


                                            <!-- STATUS -->
                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="4"
                                                Spacing="3">

                                                <Label
                                                    Text="{Binding Status}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#2563EB"
                                                    HorizontalTextAlignment="End" />

                                                <Label
                                                    Text="{Binding DateDisplay}"
                                                    FontSize="9"
                                                    TextColor="#94A3B8"
                                                    HorizontalTextAlignment="End" />

                                            </VerticalStackLayout>


                                            <!-- NOTES -->
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="5"
                                                Text="{Binding NotesDisplay}"
                                                FontSize="10"
                                                TextColor="#64748B"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </Grid>

                </Border>


                <!-- INFORMATION -->
                <Border
                    BackgroundColor="#EFF6FF"
                    Stroke="#BFDBFE"
                    StrokeShape="RoundRectangle 10"
                    Padding="15">

                    <Label
                        Text="Department figures are calculated from employee Daily Records. Business Value represents recorded business value and is not automatically treated as company revenue."
                        FontSize="10"
                        TextColor="#1E40AF" />

                </Border>


                <!-- FOOTER -->
                <Label
                    Text="InsightFlow • Department Analytics"
                    FontSize="9"
                    TextColor="#94A3B8"
                    HorizontalTextAlignment="Center"
                    Margin="0,0,0,15" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>