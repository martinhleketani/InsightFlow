<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="InsightFlow.SalesPage"
    Title="Sales"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Border
            Grid.Row="0"
            BackgroundColor="#0F2747"
            StrokeThickness="0"
            Padding="25,18">

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="15">

                <Button
                    Grid.Column="0"
                    Text="← Back"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="OnBackClicked" />

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="3">

                    <Label
                        Text="SALES ANALYTICS"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Sales department performance from employee submissions"
                        FontSize="11"
                        TextColor="#93C5FD" />

                </VerticalStackLayout>

                <Button
                    Grid.Column="2"
                    Text="REFRESH"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="OnRefreshClicked" />

            </Grid>

        </Border>

        <!-- MAIN CONTENT -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="25"
                Spacing="20">

                <!-- PAGE INFORMATION -->
                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="3">

                        <Label
                            Text="Sales Overview"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Label
                            x:Name="LastUpdatedLabel"
                            Text="Waiting for sales data"
                            FontSize="11"
                            TextColor="#64748B" />

                    </VerticalStackLayout>

                    <ActivityIndicator
                        Grid.Column="1"
                        x:Name="LoadingIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        Color="#2563EB"
                        WidthRequest="35"
                        HeightRequest="35" />

                </Grid>

                <!-- ERROR MESSAGE -->
                <Border
                    x:Name="ErrorBorder"
                    IsVisible="False"
                    BackgroundColor="#FEF2F2"
                    Stroke="#FECACA"
                    StrokeShape="RoundRectangle 8"
                    Padding="12">

                    <Label
                        x:Name="ErrorLabel"
                        FontSize="11"
                        TextColor="#DC2626" />

                </Border>

                <!-- MAIN KPI CARDS -->
                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="15">

                    <!-- TOTAL ACTIVITIES -->
                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="SALES ACTIVITIES"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="TotalActivitiesLabel"
                                Text="0"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Submitted Sales records"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- BUSINESS VALUE -->
                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="BUSINESS VALUE"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="TotalBusinessValueLabel"
                                Text="R 0.00"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Total recorded value"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- QUANTITY -->
                    <Border
                        Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="TOTAL QUANTITY"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="TotalQuantityLabel"
                                Text="0"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#2563EB" />

                            <Label
                                Text="Combined recorded units"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- COMPLETED -->
                    <Border
                        Grid.Column="3"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="COMPLETED"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="CompletedActivitiesLabel"
                                Text="0"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#16A34A" />

                            <Label
                                Text="Completed Sales records"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>

                <!-- SECONDARY METRICS -->
                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="15">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="AVERAGE VALUE"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="AverageValueLabel"
                                Text="R 0.00"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Per submitted record"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="COMPLETION RATE"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="CompletionRateLabel"
                                Text="0%"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="#2563EB" />

                            <Label
                                Text="Completed / total records"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="SALES CONTRIBUTORS"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#64748B" />

                            <Label
                                x:Name="ContributorsLabel"
                                Text="0"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Employees with submissions"
                                FontSize="9"
                                TextColor="#94A3B8" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>

                <!-- STATUS AND ACTIVITY BREAKDOWN -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="20">

                    <!-- STATUS -->
                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">

                        <VerticalStackLayout Spacing="16">

                            <Label
                                Text="Sales Work Status"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Completed"
                                    TextColor="#475569"
                                    FontSize="12" />

                                <Label
                                    Grid.Column="1"
                                    x:Name="CompletedStatusLabel"
                                    Text="0"
                                    TextColor="#16A34A"
                                    FontAttributes="Bold" />

                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="In Progress"
                                    TextColor="#475569"
                                    FontSize="12" />

                                <Label
                                    Grid.Column="1"
                                    x:Name="InProgressStatusLabel"
                                    Text="0"
                                    TextColor="#2563EB"
                                    FontAttributes="Bold" />

                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="Pending"
                                    TextColor="#475569"
                                    FontSize="12" />

                                <Label
                                    Grid.Column="1"
                                    x:Name="PendingStatusLabel"
                                    Text="0"
                                    TextColor="#64748B"
                                    FontAttributes="Bold" />

                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Text="On Hold"
                                    TextColor="#475569"
                                    FontSize="12" />

                                <Label
                                    Grid.Column="1"
                                    x:Name="OnHoldStatusLabel"
                                    Text="0"
                                    TextColor="#64748B"
                                    FontAttributes="Bold" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                    <!-- ACTIVITY BREAKDOWN -->
                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">

                        <Grid RowDefinitions="Auto,*">

                            <Label
                                Grid.Row="0"
                                Text="Activity Breakdown"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#0F172A"
                                Margin="0,0,0,12" />

                            <CollectionView
                                Grid.Row="1"
                                x:Name="ActivityBreakdownCollectionView"
                                SelectionMode="None"
                                HeightRequest="210">

                                <CollectionView.EmptyView>

                                    <Label
                                        Text="No Sales activity data available."
                                        TextColor="#94A3B8"
                                        HorizontalTextAlignment="Center"
                                        Margin="15" />

                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="10"
                                            BackgroundColor="#F8FAFC"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 8">

                                            <Grid ColumnDefinitions="*,Auto,Auto"
                                                  ColumnSpacing="12">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="{Binding ActivityType}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#0F172A" />

                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding CountDisplay}"
                                                    FontSize="10"
                                                    TextColor="#64748B" />

                                                <Label
                                                    Grid.Column="2"
                                                    Text="{Binding ValueDisplay}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#2563EB" />

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </CollectionView.ItemTemplate>

                            </CollectionView>

                        </Grid>

                    </Border>

                </Grid>

                <!-- SEARCH -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="15">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="15">

                        <Border
                            Grid.Column="0"
                            BackgroundColor="#F8FAFC"
                            Stroke="#CBD5E1"
                            StrokeShape="RoundRectangle 8"
                            Padding="10,2">

                            <Entry
                                x:Name="SearchEntry"
                                Placeholder="Search Sales employee, activity, reference or notes..."
                                TextColor="#0F172A"
                                PlaceholderColor="#94A3B8"
                                TextChanged="OnSearchTextChanged" />

                        </Border>

                        <Label
                            Grid.Column="1"
                            x:Name="RecordCountLabel"
                            Text="0 records"
                            FontSize="11"
                            TextColor="#64748B"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

                <!-- SALES RECORDS -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <Grid RowDefinitions="Auto,*">

                        <VerticalStackLayout
                            Grid.Row="0"
                            Spacing="3"
                            Margin="0,0,0,15">

                            <Label
                                Text="Sales Employee Records"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <Label
                                Text="Latest submitted Sales department activities"
                                FontSize="10"
                                TextColor="#64748B" />

                        </VerticalStackLayout>

                        <CollectionView
                            Grid.Row="1"
                            x:Name="SalesRecordsCollectionView"
                            SelectionMode="None"
                            HeightRequest="380">

                            <CollectionView.EmptyView>

                                <VerticalStackLayout
                                    Padding="30"
                                    Spacing="8">

                                    <Label
                                        Text="No Sales records found"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="#64748B"
                                        HorizontalTextAlignment="Center" />

                                    <Label
                                        Text="Sales employee submissions will appear here."
                                        FontSize="11"
                                        TextColor="#94A3B8"
                                        HorizontalTextAlignment="Center" />

                                </VerticalStackLayout>

                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="15"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 10">

                                        <Grid
                                            ColumnDefinitions="1.3*,1.5*,*,Auto"
                                            RowDefinitions="Auto,Auto"
                                            ColumnSpacing="15"
                                            RowSpacing="6">

                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="3">

                                                <Label
                                                    Text="{Binding EmployeeName}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="#0F172A" />

                                                <Label
                                                    Text="{Binding EmployeeId}"
                                                    FontSize="10"
                                                    TextColor="#94A3B8" />

                                            </VerticalStackLayout>

                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Spacing="3">

                                                <Label
                                                    Text="{Binding ActivityType}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="#0F172A" />

                                                <Label
                                                    Text="{Binding ReferenceDisplay}"
                                                    FontSize="10"
                                                    TextColor="#64748B" />

                                            </VerticalStackLayout>

                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Spacing="3">

                                                <Label
                                                    Text="{Binding BusinessValueDisplay}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="#0F172A" />

                                                <Label
                                                    Text="{Binding QuantityDisplay}"
                                                    FontSize="10"
                                                    TextColor="#64748B" />

                                            </VerticalStackLayout>

                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                Spacing="3">

                                                <Label
                                                    Text="{Binding Status}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#2563EB"
                                                    HorizontalTextAlignment="End" />

                                                <Label
                                                    Text="{Binding DateDisplay}"
                                                    FontSize="10"
                                                    TextColor="#94A3B8"
                                                    HorizontalTextAlignment="End" />

                                            </VerticalStackLayout>

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="4"
                                                Text="{Binding NotesDisplay}"
                                                FontSize="10"
                                                TextColor="#64748B"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </Grid>

                </Border>

                <Label
                    Text="InsightFlow • Sales Analytics"
                    FontSize="9"
                    TextColor="#94A3B8"
                    HorizontalTextAlignment="Center"
                    Margin="0,0,0,15" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
