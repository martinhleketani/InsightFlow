<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="InsightFlow.EmployeeDashboardPage"
    Title="Employee Dashboard"
    BackgroundColor="#F8FAFC"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="35,28"
            Spacing="24">

            <!-- ================================ -->
            <!-- HEADER -->
            <!-- ================================ -->

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="4">

                    <Label
                        Text="INSIGHTFLOW"
                        FontSize="13"
                        FontAttributes="Bold"
                        CharacterSpacing="2"
                        TextColor="#2563EB" />

                    <Label
                        Text="Employee Workspace"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

                    <Label
                        Text="Record your daily work and monitor your activity."
                        FontSize="13"
                        TextColor="#64748B" />

                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    Text="Logout"
                    BackgroundColor="#F1F5F9"
                    TextColor="#475569"
                    FontAttributes="Bold"
                    FontSize="12"
                    HeightRequest="42"
                    Padding="20,0"
                    CornerRadius="8"
                    VerticalOptions="Center"
                    Clicked="OnLogoutClicked" />

            </Grid>


            <!-- ================================ -->
            <!-- EMPLOYEE INFORMATION -->
            <!-- ================================ -->

            <Border
                BackgroundColor="#0F2747"
                Stroke="#0F2747"
                StrokeShape="RoundRectangle 14"
                Padding="24">

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="18">

                    <!-- PROFILE INITIAL -->

                    <Border
                        WidthRequest="62"
                        HeightRequest="62"
                        BackgroundColor="#2563EB"
                        Stroke="#2563EB"
                        StrokeShape="RoundRectangle 31">

                        <Label
                            x:Name="EmployeeInitialLabel"
                            Text="E"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>


                    <!-- EMPLOYEE DETAILS -->

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">

                        <Label
                            x:Name="EmployeeNameLabel"
                            Text="Development Employee"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            x:Name="EmployeePositionLabel"
                            Text="Sales Representative"
                            FontSize="12"
                            TextColor="#CBD5E1" />

                        <HorizontalStackLayout Spacing="8">

                            <Label
                                x:Name="EmployeeIdLabel"
                                Text="IF-SAL-0001"
                                FontSize="11"
                                TextColor="#93C5FD" />

                            <Label
                                Text="•"
                                FontSize="11"
                                TextColor="#64748B" />

                            <Label
                                x:Name="DepartmentLabel"
                                Text="Sales Department"
                                FontSize="11"
                                TextColor="#93C5FD" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>


                    <!-- ACCOUNT STATUS -->

                    <Border
                        Grid.Column="2"
                        BackgroundColor="#DCFCE7"
                        Stroke="#BBF7D0"
                        StrokeShape="RoundRectangle 20"
                        Padding="14,7"
                        VerticalOptions="Center">

                        <Label
                            Text="● ACTIVE"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#16A34A" />

                    </Border>

                </Grid>

            </Border>


            <!-- ================================ -->
            <!-- TODAY -->
            <!-- ================================ -->

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="3">

                    <Label
                        Text="Today's Activity"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

                    <Label
                        x:Name="CurrentDateLabel"
                        Text="Today"
                        FontSize="12"
                        TextColor="#64748B" />

                </VerticalStackLayout>


                <Border
                    Grid.Column="1"
                    BackgroundColor="#FEF3C7"
                    Stroke="#FDE68A"
                    StrokeShape="RoundRectangle 20"
                    Padding="14,7"
                    VerticalOptions="Center">

                    <Label
                        x:Name="DailyEntryStatusLabel"
                        Text="NOT SUBMITTED"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#B45309" />

                </Border>

            </Grid>


            <!-- ================================ -->
            <!-- RECORD DAILY WORK -->
            <!-- ================================ -->

            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 14"
                Padding="25">

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="25">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="Record Today's Work"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Label
                            Text="Enter the work and business activity you completed today."
                            FontSize="12"
                            TextColor="#64748B" />

                        <Label
                            Text="Your submitted information contributes to department and company performance reports."
                            FontSize="11"
                            TextColor="#94A3B8" />

                    </VerticalStackLayout>


                    <Button
                        Grid.Column="1"
                        Text="+  Record Daily Data"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="13"
                        HeightRequest="48"
                        Padding="22,0"
                        CornerRadius="8"
                        VerticalOptions="Center"
                        Clicked="OnRecordDailyDataClicked" />

                </Grid>

            </Border>


            <!-- ================================ -->
            <!-- EMPLOYEE SUMMARY -->
            <!-- ================================ -->

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="16">

                <!-- ENTRIES -->

                <Border
                    Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="MY ENTRIES"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#64748B" />

                        <Label
                            x:Name="TotalEntriesLabel"
                            Text="0"
                            FontSize="27"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Label
                            Text="Records submitted this month"
                            FontSize="11"
                            TextColor="#94A3B8" />

                    </VerticalStackLayout>

                </Border>


                <!-- DAYS REPORTED -->

                <Border
                    Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="DAYS REPORTED"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#64748B" />

                        <Label
                            x:Name="DaysReportedLabel"
                            Text="0"
                            FontSize="27"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Label
                            Text="Working days recorded"
                            FontSize="11"
                            TextColor="#94A3B8" />

                    </VerticalStackLayout>

                </Border>


                <!-- ACCOUNT STATUS -->

                <Border
                    Grid.Column="2"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="20">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="ACCOUNT STATUS"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#64748B" />

                        <Label
                            Text="Active"
                            FontSize="27"
                            FontAttributes="Bold"
                            TextColor="#16A34A" />

                        <Label
                            Text="Company account approved"
                            FontSize="11"
                            TextColor="#94A3B8" />

                    </VerticalStackLayout>

                </Border>

            </Grid>


            <!-- ================================ -->
            <!-- QUICK ACCESS -->
            <!-- ================================ -->

            <VerticalStackLayout Spacing="12">

                <Label
                    Text="Quick Access"
                    FontSize="19"
                    FontAttributes="Bold"
                    TextColor="#0F172A" />


                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="16">

                    <!-- MY ENTRIES -->

                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="22">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="My Entries"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#0F172A" />

                                <Label
                                    Text="View the daily records you have submitted."
                                    FontSize="11"
                                    TextColor="#64748B" />

                            </VerticalStackLayout>


                            <Button
                                Grid.Column="1"
                                Text="View"
                                BackgroundColor="#EFF6FF"
                                TextColor="#2563EB"
                                FontAttributes="Bold"
                                FontSize="11"
                                HeightRequest="40"
                                Padding="18,0"
                                CornerRadius="7"
                                VerticalOptions="Center"
                                Clicked="OnMyEntriesClicked" />

                        </Grid>

                    </Border>


                    <!-- MY PERFORMANCE -->

                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="22">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="My Performance"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#0F172A" />

                                <Label
                                    Text="Review your own activity and performance."
                                    FontSize="11"
                                    TextColor="#64748B" />

                            </VerticalStackLayout>


                            <Button
                                Grid.Column="1"
                                Text="View"
                                BackgroundColor="#EFF6FF"
                                TextColor="#2563EB"
                                FontAttributes="Bold"
                                FontSize="11"
                                HeightRequest="40"
                                Padding="18,0"
                                CornerRadius="7"
                                VerticalOptions="Center"
                                Clicked="OnMyPerformanceClicked" />

                        </Grid>

                    </Border>

                </Grid>

            </VerticalStackLayout>


            <!-- ================================ -->
            <!-- ACCESS INFORMATION -->
            <!-- ================================ -->

            <Border
                BackgroundColor="#F8FAFC"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 10"
                Padding="15">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">

                    <Label
                        Text="🔒"
                        FontSize="16"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2">

                        <Label
                            Text="Employee access"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="#475569" />

                        <Label
                            Text="You can record and review your own work. Company-wide administration and management information remain restricted."
                            FontSize="10"
                            TextColor="#94A3B8" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- FOOTER -->

            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,5,0,10">

                <Label
                    Text="MARTIN / INSIGHTFLOW"
                    FontSize="10"
                    FontAttributes="Bold"
                    TextColor="#94A3B8" />

                <Label
                    Grid.Column="1"
                    Text="Employee Portal"
                    FontSize="10"
                    TextColor="#94A3B8" />

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>